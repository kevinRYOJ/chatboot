# Konfigurasi API Chatbot Olahraga
# Dapatkan API Key gratis di: https://aistudio.google.com/app/apikey
   GEMINI_API_KEY=isi_api_key_kamu_di_sini
# Urutan Model AI Gemini (Otomatis switch ke model cadangan jika kuota habis)
GEMINI_MODELS=gemini-3.5-flash, gemini-3.1-flash-lite

# Konfigurasi Aplikasi
APP_NAME="All-in-One Sport Chatbot"
APP_ENV=development
