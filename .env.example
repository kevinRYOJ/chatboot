# ============================================================
#  All-in-One Sport Chatbot — Konfigurasi Aplikasi
#  Salin file ini menjadi .env, lalu isi nilai yang diperlukan
#  cp .env.example .env  (Mac/Linux)
#  copy .env.example .env  (Windows CMD)
# ============================================================

# --- WAJIB DIISI ---
# Dapatkan API Key gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=isi_api_key_kamu_di_sini

# --- DATABASE MySQL (WAJIB DIISI) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sportchatbot
DB_USER=root
DB_PASS=

# --- OPSIONAL ---
# Urutan model Gemini (otomatis switch ke model berikutnya jika kuota habis)
GEMINI_MODELS=gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-flash-8b, gemini-1.5-pro

# Nama aplikasi yang ditampilkan di UI
APP_NAME="All-in-One Sport Chatbot"

# Environment: development / production
APP_ENV=development
